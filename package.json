{
  "name": "shichida-memory-card",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check": "npx @biomejs/biome check --apply .",
    "postinstall": "npx husky install",
    "ios": "expo run:ios",
    "prebuild": "npx expo prebuild --clean",
    "start": "expo start",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "web": "expo start --web"
  },
  "nano-staged": {
    "*.{js,ts,json,md}": "biome check --apply"
  },
  "dependencies": {
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.0.10",
    "@gluestack-ui/themed": "^1.1.73",
    "@tanstack/react-query": "^5.17.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^1.4.1",
    "@types/react": "~19.2.4",
    "husky": "^8.0.3",
    "nano-staged": "^0.9.0",
    "typescript": "~6.0.3"
  }
}
